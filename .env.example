# ── Content path ──────────────────────────────────────────────────────────────
# Path to the programs/ directory, relative to the viewer root.
#
# When the viewer is installed as a submodule inside open-curriculum/:
#   ../programs  (default — no change needed)
#
# When running platform-poc/ directly alongside open-curriculum/ during development:
#   CONTENT_BASE_PATH=../open-curriculum/programs
#
# CONTENT_BASE_PATH=../open-curriculum/programs

# ── Program selection ─────────────────────────────────────────────────────────
# Folder name of the program to display (must be a subfolder of programs/ containing manifest.yml).
# Default: auto-detects the first program found.
#
# PROGRAM_FOLDER=ai-project-manager
